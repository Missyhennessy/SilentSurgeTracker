modules = ["nodejs-20", "web", "postgresql-16", "python-3.11", "python3"]
run = "npm run dev"
hidden = [".config", ".git", "generated-icon.png", "node_modules", "dist"]

[nix]
channel = "stable-24_05"
packages = ["cairo", "ffmpeg-full", "freetype", "ghostscript", "glibcLocales", "gobject-introspection", "gtk3", "libcxx", "pkg-config", "qhull", "redis", "tcl", "tk"]

[deployment]
deploymentTarget = "autoscale"
build = ["npm", "run", "build"]
run = ["npm", "run", "start"]

[[ports]]
localPort = 5000
externalPort = 80

[[ports]]
localPort = 6379
externalPort = 5173

[[ports]]
localPort = 34225
externalPort = 8080

[[ports]]
localPort = 34833
externalPort = 6000

[[ports]]
localPort = 38051
externalPort = 3003

[[ports]]
localPort = 38353
externalPort = 8000

[[ports]]
localPort = 38671
externalPort = 3001

[[ports]]
localPort = 42231
externalPort = 6800

[[ports]]
localPort = 42535
externalPort = 3002

[[ports]]
localPort = 43109
externalPort = 4200

[[ports]]
localPort = 43129
externalPort = 5000

[[ports]]
localPort = 46009
externalPort = 8008

[[ports]]
localPort = 46183
externalPort = 3000

[env]
PORT = "5000"

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Start application"

[[workflows.workflow]]
name = "Start application"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "npm run dev"
waitForPort = 5000

[agent]
integrations = ["javascript_openai==1.0.0", "javascript_log_in_with_replit==1.0.0", "javascript_stripe==1.0.0", "javascript_database==1.0.0"]
